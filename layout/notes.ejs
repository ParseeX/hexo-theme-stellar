<%# 笔记列表页主体部分 %>
<% const recipeGrid = page.notebook === "recipes" %>
<div class="post-list post<%= recipeGrid ? " recipe-grid" : "" %>">
  <% page.posts.each(post => { %>
    <a
      class="post-card<%= scrollreveal(' ') %> post"
      href="<%= pretty_url(post.link || post.path) %><%= page.activeTag ? `?tag=${page.activeTag}` : '' %>"
    >
      <%- include('_partial/main/notebook/note_card', { note: post, recipeGrid: recipeGrid }) %>
    </a>
  <% }) %>
</div>
<%- include('_partial/main/notebook/paginator') %>
